# Example Wi-Fi config written by the portal / admin UI to CFGDIR/wifi.conf.
# Do not put real PSKs in the repository. On device this file is created at runtime.

ssid=YourHomeNetwork
psk=your-wifi-password
key_mgmt=WPA-PSK
