# Example user service for host-assisted SD recording.
# Install only AFTER confirming the old host recorder is stopped.
#
#   mkdir -p ~/.config/systemd/user
#   # edit paths/IP below, then:
#   cp localcam-host-recorder.service.example ~/.config/systemd/user/localcam-host-recorder.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now localcam-host-recorder.service
#
# Quote ExecStart paths that contain spaces. Requires firmware/private/cam_creds.env.

[Unit]
Description=LocalCam host RTSP→SD recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/andrejl/Documents/Code Projects/Open-iSC5-IP-Camera
Environment=PATH=/home/andrejl/.local/bin:/usr/bin:/bin
ExecStart="/home/andrejl/Documents/Code Projects/Open-iSC5-IP-Camera/firmware/.venv/bin/python" "firmware/scripts/host_recorder.py" "-u" "rtsp://192.168.187.180:554/unicast" "-t" "20"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
